# MONGODB_URL: Connection string to your MongoDB Atlas database.
MONGODB_URL="mongodb+srv://username:password@cluster.mongodb.net/Uplink_contact?retryWrites=true&w=majority"
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/Uplink_contact?retryWrites=true&w=majority"

# GEMINI_API_KEY: Required for secure Google Gemini AI requests.
GEMINI_API_KEY="your_gemini_api_key_here"

# PORT: Server port (defaults to 3000 if not set).
PORT=3000

# APP_URL: Public production URL where backend is deployed (e.g., Render URL).
APP_URL="https://your-app-name.onrender.com"
